      "check": {
        "js": "inv && Math.abs(inv.vol_kernel - 40075.2) < 10",
        "desc": "vol final ≈ 40,075 mm³ (2 barrenos Ø20 exactos)"
      }
    },
    {
      "id": "p15",
      "dice": "Ejercicio uno punto uno y uno punto dos del libro: superados. El kernel da fe. Nos vemos en la siguiente.",
      "gestos": [
        {
          "type": "orbit",
          "from": [
            1150,
            620
          ],
          "to": [
            820,
            560
          ],
          "settle": 800
        },
        {
          "type": "orbit",
          "from": [
            1000,
            600
          ],
          "to": [
            1180,
            680
          ],
          "settle": 900
