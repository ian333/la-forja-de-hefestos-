        {
          "type": "hook",
          "fn": "clearPick",
          "args": [],
          "settle": 300
        },
        {
          "type": "hook",
          "fn": "pick",
          "args": [
            "line",
            0
          ],
          "settle": 250
        },
        {
          "type": "hook",
          "fn": "pick",
          "args": [
            "line",
            2
          ],
          "settle": 250
        },
        {
          "type": "hook",
          "fn": "pick",
          "args": [
            "line",
            4
          ],
          "settle": 250
        },
        {
          "type": "tclick",
          "testid": "sk-con-h",
          "settle": 900
        },
        {
          "type": "hook",
          "fn": "clearPick",
          "args": [],
          "settle": 300
        },
        {
          "type": "hook",
          "fn": "pick",
          "args": [
            "line",
            1
          ],
          "settle": 250
        },
        {
          "type": "hook",
          "fn": "pick",
          "args": [
            "line",
            3
          ],
          "settle": 250
        },
        {
          "type": "hook",
          "fn": "pick",
          "args": [
            "line",
            5
          ],
          "settle": 250
