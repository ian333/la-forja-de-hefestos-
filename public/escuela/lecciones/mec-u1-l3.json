        {
          "type": "tclick",
          "testid": "sk-con-v",
          "settle": 900
        },
        {
          "type": "hook",
          "fn": "clearPick",
          "args": [],
          "settle": 300
        }
      ]
    },
    {
      "id": "p05",
      "dice": "Ahora las órdenes. La base: ochenta milímetros.",
