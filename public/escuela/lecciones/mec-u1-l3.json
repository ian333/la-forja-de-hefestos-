        {
          "type": "hook",
          "fn": "dimDist",
          "args": [
            0,
            1,
            "h"
          ],
          "settle": 900
        },
        {
          "type": "fill",
          "testid": "sk-dim-input",
          "text": "80",
          "settle": 400
        },
        {
          "type": "key",
          "key": "Enter",
          "settle": 1100
        }
      ]
    },
    {
      "id": "p06",
      "dice": "El talón derecho: treinta.",
      "gestos": [
        {
          "type": "hook",
          "fn": "dimDist",
          "args": [
            1,
            2,
            "v"
          ],
          "settle": 900
        },
        {
          "type": "fill",
          "testid": "sk-dim-input",
          "text": "30",
          "settle": 400
        },
        {
          "type": "key",
          "key": "Enter",
          "settle": 1100
        }
      ]
    },
    {
      "id": "p07",
      "dice": "El brazo de arriba: treinta también.",
      "gestos": [
        {
          "type": "hook",
          "fn": "dimDist",
          "args": [
            4,
            5,
            "h"
          ],
          "settle": 900
        },
        {
          "type": "fill",
          "testid": "sk-dim-input",
          "text": "30",
          "settle": 400
        },
        {
          "type": "key",
          "key": "Enter",
          "settle": 1100
        }
      ]
    },
    {
      "id": "p08",
      "dice": "Y la altura total: sesenta. Cuatro cotas, y la geometría entera obedece.",
      "gestos": [
        {
          "type": "hook",
          "fn": "dimDist",
          "args": [
            5,
            0,
            "v"
          ],
          "settle": 900
        },
        {
          "type": "fill",
          "testid": "sk-dim-input",
          "text": "60",
          "settle": 400
        },
        {
          "type": "key",
          "key": "Enter",
          "settle": 1100
        }
      ]
    },
    {
      "id": "p09",
      "dice": "Ancla la esquina... y ahí está: totalmente restringido. Igual que en la página del libro.",
      "gestos": [
        {
          "type": "tclick",
          "testid": "sk-tool-fix",
          "settle": 500
        },
        {
          "type": "clickptwhere",
          "where": "bl",
          "settle": 1100
        }
      ],
      "check": {
        "js": "sk && sk.dof === 0",
        "desc": "DOF 0 — totalmente restringido"
      }
    },
    {
      "id": "p10",
      "dice": "Termina el boceto... y extruye: quince milímetros de espesor.",
      "gestos": [
        {
          "type": "tclick",
          "testid": "sk-finish",
          "settle": 2000
        },
        {
          "type": "tclick",
          "testid": "btn-extrude",
          "settle": 2000
        },
        {
          "type": "fill",
          "testid": "input-altura",
          "text": "15",
          "settle": 1800
        }
      ],
      "check": {
        "js": "inv && Math.abs(inv.vol_kernel - 49500) < 5",
        "desc": "la L extruida mide 49,500 mm³ exactos"
      }
    },
    {
      "id": "p11",
      "dice": "Ahora los barrenos del ejercicio uno punto dos. Cortar... Boceto... y clic en la cara de la pieza.",
      "gestos": [
        {
          "type": "tclick",
          "testid": "sketch-op-cut",
          "settle": 800
        },
        {
          "type": "view",
          "name": "iso",
          "settle": 1100
        },
        {
          "type": "tclick",
          "testid": "btn-sketch",
          "settle": 1100
        },
        {
          "type": "click",
          "x": 960,
          "y": 640,
          "settle": 1800
        }
      ],
      "check": {
        "js": "sk && sk.ready",
        "desc": "boceto sobre la cara de la L"
      }
    },
    {
      "id": "p12",
      "dice": "Dos círculos a ojo: uno en el brazo... y otro en la base.",
      "gestos": [
        {
          "type": "tclick",
          "testid": "sk-tool-circle",
          "settle": 500
        },
        {
          "type": "clickmm",
          "x": -25,
          "y": 15,
          "settle": 500
        },
        {
          "type": "clickmm",
          "x": -16,
          "y": 15,
          "settle": 700
        },
        {
          "type": "clickmm",
          "x": 15,
          "y": -15,
          "settle": 500
        },
        {
          "type": "clickmm",
          "x": 24,
          "y": -15,
          "settle": 700
        }
      ],
      "check": {
        "js": "sk && sk.nCircles >= 2",
        "desc": "hay dos círculos"
      }
    },
    {
      "id": "p13",
      "dice": "El libro los pide de veinte: cota de diámetro al primero... y al segundo.",
      "gestos": [
        {
          "type": "hook",
          "fn": "dimDiam",
          "args": [
            0
          ],
          "settle": 800
        },
        {
          "type": "fill",
          "testid": "sk-dim-input",
          "text": "20",
          "settle": 400
        },
        {
          "type": "key",
          "key": "Enter",
          "settle": 900
        },
        {
          "type": "hook",
          "fn": "dimDiam",
          "args": [
            1
          ],
          "settle": 800
        },
        {
          "type": "fill",
          "testid": "sk-dim-input",
          "text": "20",
          "settle": 400
        },
        {
          "type": "key",
          "key": "Enter",
          "settle": 900
        }
      ]
    },
    {
      "id": "p14",
      "dice": "Termina el boceto... y los dos cortes atraviesan la placa. La ele del libro, barrenada.",
      "gestos": [
        {
          "type": "tclick",
          "testid": "sk-finish",
          "settle": 2600
        },
        {
          "type": "probe",
          "label": "post-barrenos"
        }
