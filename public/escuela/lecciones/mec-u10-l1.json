        {
          "type": "tclick",
          "testid": "btn-mas",
          "settle": 900
        },
        {
          "type": "tclick",
          "testid": "btn-gear",
          "settle": 3400
        },
        {
          "type": "probe",
          "label": "gear-fabrica"
        }
      ],
      "check": {
        "js": "inv && inv.vol_kernel > 1000",
        "desc": "el engrane existe"
      }
    },
    {
