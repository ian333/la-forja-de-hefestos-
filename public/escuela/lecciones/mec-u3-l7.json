          "y": 0,
          "settle": 450
        },
        {
          "type": "clickmm",
          "x": 3,
          "y": 1,
          "settle": 700
        },
        {
          "type": "hook",
          "fn": "dimDiam",
          "args": [
            0
          ],
          "settle": 800
