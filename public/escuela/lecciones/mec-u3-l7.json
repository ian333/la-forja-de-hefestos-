        "desc": "el perfil del alambre quedó guardado"
      }
    },
    {
      "id": "p03",
      "dice": "En el menú Más: barrido. El perfil recorre un camino...",
      "gestos": [
        {
          "type": "tclick",
          "testid": "btn-mas",
          "settle": 900
        },
        {
          "type": "tclick",
          "testid": "btn-sweep",
          "settle": 2800
        },
        {
          "type": "probe",
          "label": "post-sweep"
        }
      ],
      "check": {
        "js": "inv && inv.ops && inv.ops.includes('sweep')",
