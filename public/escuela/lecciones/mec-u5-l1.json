      "gestos": [
        {
          "type": "wait",
          "ms": 900
        }
      ]
    },
    {
      "id": "p02",
      "dice": "Un ensamble empieza limpio: fuera la pieza de demostración.",
      "gestos": [
        {
          "type": "tclick",
          "testid": "tl-extrude",
          "settle": 1000
